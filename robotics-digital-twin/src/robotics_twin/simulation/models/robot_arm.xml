<mujoco model="digital_twin_robot">
  <compiler angle="radian" coordinate="local"/>
  <option gravity="0 0 -9.81" timestep="0.002" iterations="100"/>

  <visual>
    <headlight ambient="0.6 0.6 0.6"/>
  </visual>

  <default>
    <joint damping="1.5" armature="0.1"/>
    <geom friction="1.0 0.005 0.0001" solref="0.01 1"/>
  </default>

  <equality>
    <weld name="gripper_weld" body1="end_effector" body2="workpiece" active="false" solref="0.02 1" solimp="0.9 0.95 0.001"/>
  </equality>

  <contact>
    <exclude body1="base_link" body2="link1"/>
    <exclude body1="link1" body2="link2"/>
    <exclude body1="link2" body2="link3"/>
    <exclude body1="link3" body2="link4"/>
    <exclude body1="link4" body2="link5"/>
    <exclude body1="link5" body2="end_effector"/>
  </contact>

  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.05" rgba="0.85 0.85 0.85 1"/>
    <light directional="true" pos="0 0 3" dir="0 0 -1"/>

    <!-- Robot Arm -->
    <body name="base_link" pos="0 0 0.05">
      <geom name="base_geom" type="cylinder" size="0.08 0.05" rgba="0.2 0.2 0.2 1"/>

      <body name="link1" pos="0 0 0.12">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-6.283 6.283"/>
        <geom name="link1_geom" type="cylinder" size="0.06 0.05" rgba="0.15 0.5 0.8 1" mass="4.0"/>

        <body name="link2" pos="0 0 0.06" quat="0.7071 0.7071 0 0">
          <joint name="joint2" type="hinge" axis="0 0 1" range="-3.1415 3.1415"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 -0.425 0 0" size="0.05" rgba="0.8 0.8 0.85 1" mass="8.0"/>

          <body name="link3" pos="-0.425 0 0">
            <joint name="joint3" type="hinge" axis="0 0 1" range="-3.1415 3.1415"/>
            <geom name="link3_geom" type="capsule" fromto="0 0 0 -0.392 0 0" size="0.04" rgba="0.15 0.5 0.8 1" mass="3.0"/>

            <body name="link4" pos="-0.392 0 0.109" quat="0.7071 0.7071 0 0">
              <joint name="joint4" type="hinge" axis="0 0 1" range="-6.283 6.283"/>
              <geom name="link4_geom" type="cylinder" size="0.035 0.04" rgba="0.8 0.8 0.85 1" mass="1.5"/>

              <body name="link5" pos="0 0 0.094" quat="0.7071 -0.7071 0 0">
                <joint name="joint5" type="hinge" axis="0 0 1" range="-6.283 6.283"/>
                <geom name="link5_geom" type="cylinder" size="0.035 0.04" rgba="0.15 0.5 0.8 1" mass="1.2"/>

                <body name="end_effector" pos="0 0 0.082">
                  <joint name="joint6" type="hinge" axis="0 0 1" range="-6.283 6.283"/>
                  <geom name="ee_geom" type="cylinder" size="0.03 0.02" rgba="0.1 0.7 0.3 1" mass="0.8"/>
                  <site name="ee_site" pos="0 0 0.02" size="0.01"/>
                  <camera name="eye_in_hand" pos="0 0 0.03" quat="0 1 0 0" fovy="60" mode="fixed"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- Worktable (Pick Station) -->
    <body name="worktable" pos="0.5 0 0.2">
      <geom name="table_top" type="box" size="0.25 0.35 0.2" rgba="0.3 0.3 0.35 1"/>
    </body>

    <!-- Droptable (Drop Station) -->
    <body name="droptable" pos="0.0 0.5 0.2">
      <geom name="droptable_top" type="box" size="0.45 0.35 0.2" rgba="0.25 0.35 0.3 1"/>
    </body>

    <!-- Obstacle Pillar (Zone with potential field repulsion) -->
    <body name="obstacle_zone" pos="0.22 0.22 0.35">
      <geom name="obstacle_geom" type="cylinder" size="0.04 0.15" rgba="0.8 0.4 0.1 0.8"/>
    </body>

    <!-- Workpiece -->
    <body name="workpiece" pos="0.5 0 0.425">
      <freejoint name="workpiece_joint"/>
      <geom name="workpiece_geom" type="box" size="0.025 0.025 0.025" rgba="0.9 0.2 0.2 1" mass="0.05"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="actuator1" joint="joint1" gear="1" ctrllimited="true" ctrlrange="-300 300"/>
    <motor name="actuator2" joint="joint2" gear="1" ctrllimited="true" ctrlrange="-300 300"/>
    <motor name="actuator3" joint="joint3" gear="1" ctrllimited="true" ctrlrange="-300 300"/>
    <motor name="actuator4" joint="joint4" gear="1" ctrllimited="true" ctrlrange="-200 200"/>
    <motor name="actuator5" joint="joint5" gear="1" ctrllimited="true" ctrlrange="-200 200"/>
    <motor name="actuator6" joint="joint6" gear="1" ctrllimited="true" ctrlrange="-200 200"/>
  </actuator>
</mujoco>
